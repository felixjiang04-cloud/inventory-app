# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored and must NEVER be committed.

# Postgres connection string (from the Neon dashboard)
DATABASE_URL=postgresql://user:password@host/dbname

# Connection string of the Neon "test" branch — used only by pytest.
# DB tests are skipped when this is unset.
DATABASE_URL_TEST=postgresql://user:password@testhost/dbname

# The restaurant's local timezone (IANA name). Ledger dates — e.g. which
# day a stocktake counts as — are taken in this zone. Default: America/Toronto
# (same clock as Montreal).
RESTAURANT_TIMEZONE=America/Toronto
